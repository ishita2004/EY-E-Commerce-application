[Unit]
Description=Mini Store web application
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/mini-store
Environment=HOST=127.0.0.1
Environment=PORT=8000
Environment=STORE_DATA_PATH=/var/lib/mini-store/store_data.json
Environment=SECURE_COOKIE=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/mini-store/.venv/bin/python /opt/mini-store/web_server.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mini-store

[Install]
WantedBy=multi-user.target
